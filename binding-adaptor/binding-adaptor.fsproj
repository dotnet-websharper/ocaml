<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>binding-adaptor</ToolCommandName>
    <PackageId>WebSharper.BindingAdaptor</PackageId>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WebSharper.Compiler.Common" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Spec.fs" />
    <Compile Include="Generator.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
