{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "wsocaml: build",
      "type": "shell",
      "command": "bash check.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "wsocaml",
        "source": "wsocaml",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+):(\\d+): (error|warning): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "endColumn": 4,
          "severity": 5,
          "message": 6
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "clear": true }
    }
  ]
}
